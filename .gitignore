# Xcode/JUCE build output - regenerated from the .jucer files via Projucer,
# not source.
Builds/
BuildsMIDI/
xcuserdata/
*.xcuserstate

# JUCE-generated module glue code - regenerated by Projucer on resave.
# (Kept out on purpose: small enough to not matter, but it's derived, not
# authored, and regenerating it is a single Projucer --resave away.)
JuceLibraryCode/

# Python virtualenvs - large, platform-specific, never belongs in git.
**/venv/
**/__pycache__/
*.pyc

# Generated data (real, but derived/regenerable via
# MLPipeline/extract_fragments.py against the user's own stem library) -
# kept out to keep the repo focused on source, not a 1.2MB data blob.
MLPipeline/fragments/

# OS/editor cruft
.DS_Store
.claude/
